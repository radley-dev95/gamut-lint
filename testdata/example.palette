# example palette for gamut-lint
# one entry per line: name: oklch(L C H)
#   L (lightness) - 0 to 1, or a percentage
#   C (chroma)    - 0 upward, or a percentage of 0.4
#   H (hue)       - degrees, optionally followed by "deg"

background:    oklch(0.98 0.01 90)
text:          oklch(0.2 0.02 260)
brand-primary: oklch(0.65 0.15 250)
brand-accent:  oklch(0.75 0.35 145)
danger:        oklch(55% 0.28 25)
